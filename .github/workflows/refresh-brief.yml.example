# OPTIONAL — a fully self-updating news brief, with no Claude session involved.
#
# The hourly headlines job needs nothing from you. This one writes the *analysed*
# brief (summaries plus "why it matters"), which needs a model, so it needs an API key.
#
# To turn it on:
#   1. Get a key at https://console.anthropic.com
#   2. Repo Settings > Secrets and variables > Actions > New repository secret
#      Name: ANTHROPIC_API_KEY
#   3. Rename this file to refresh-brief.yml
#
# Costs a few pence a day. Check the current API and web-search docs before relying
# on it — the request shape below was written in August 2026 and may have moved on.

name: Refresh brief

on:
  schedule:
    - cron: "10 6 * * *"     # 06:10 UTC, just before the London morning
  workflow_dispatch:

permissions:
  contents: write

jobs:
  brief:
    runs-on: ubuntu-latest
    if: ${{ secrets.ANTHROPIC_API_KEY != '' }}
    steps:
      - uses: actions/checkout@v4
      - name: Write data/brief.json
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: node scripts/refresh-brief.mjs
      - name: Commit
        run: |
          if git diff --quiet -- data/brief.json; then echo "No change."; exit 0; fi
          git config user.name  "knowledge-hub-bot"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add data/brief.json
          git commit -m "Refresh daily brief"
          git push
